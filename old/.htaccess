RewriteEngine On

# Force PDF download header
<FilesMatch "\.(pdf|PDF)$">
  ForceType application/pdf
  Header set Content-Disposition "attachment; filename=\"Letter of Price BidD.pdf\""
  Header set Content-Type "application/pdf"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Forward any URL path (including //egp/download...) directly to index.php which streams the PDF
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [L,QSA]
